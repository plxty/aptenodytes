diff --git a/llvm-core/clang-common/clang-common-22.1.8.ebuild b/llvm-core/clang-common/clang-common-22.1.8.ebuild
index 80418bbf5abf..679b300bf882 100644
--- a/llvm-core/clang-common/clang-common-22.1.8.ebuild
+++ b/llvm-core/clang-common/clang-common-22.1.8.ebuild
@@ -10,12 +10,15 @@ HOMEPAGE="https://llvm.org/"
 
 LICENSE="Apache-2.0-with-LLVM-exceptions UoI-NCSA"
 SLOT="0"
-KEYWORDS="amd64 arm arm64 ~loong ~mips ppc ppc64 ~riscv ~sparc x86 ~arm64-macos ~x64-macos"
+KEYWORDS="~arm64-macos"
 IUSE="
 	default-compiler-rt default-libcxx default-lld
 	bootstrap-prefix cet emacs hardened llvm-libunwind
 "
 
+# FIXME: ways to avoid hardcoding the gcc version?
+GCC_SLOT="16"
+RDEPEND="sys-devel/gcc:${GCC_SLOT}"
 PDEPEND="
 	default-compiler-rt? (
 		llvm-runtimes/clang-runtime:${LLVM_MAJOR}[compiler-rt]
@@ -162,8 +165,9 @@ src_install() {
 		# This file is initially generated by llvm-runtimes/clang-runtime.
 		# It is used to control the default runtimes using by clang.
 
-		--rtlib=$(usex default-compiler-rt compiler-rt libgcc)
-		--unwindlib=$(usex default-compiler-rt libunwind libgcc)
+		# workaround to use system compiler-rt in darwin, instead of libgcc:
+		--rtlib=$(usex default-compiler-rt compiler-rt platform)
+		--unwindlib=$(usex default-compiler-rt libunwind platform)
 		--stdlib=$(usex default-libcxx libc++ libstdc++)
 		-fuse-ld=$(usex default-lld lld bfd)
 	EOF
@@ -317,6 +321,21 @@ src_install() {
 		elisp-install clang ../tools/clang-format/clang-format.{el,elc}
 		elisp-make-site-file "${SITEFILE}" clang
 	fi
+
+	for abi in $(get_all_abis); do
+		local abi_chost=$(get_abi_CHOST "${abi}")
+		{
+			# gentoo-gcc-install.cfg should takes care?
+			echo "-Wl,-rpath,${EPREFIX}/usr/lib/gcc/${abi_chost}/${GCC_SLOT}"
+			echo "-Wl,-L,${EPREFIX}/usr/lib/gcc/${abi_chost}/${GCC_SLOT}"
+		} >>"${ED}/etc/clang/gentoo-common.cfg"
+
+		# symlink a macosx one, trick cc-rs/src/target/generated.rs:
+		# @see clang-runtime
+		for tool in clang{,++,-cpp}; do
+			dosym "${abi_chost}-${tool}.cfg" "/etc/clang/${abi_chost/darwin25/macosx}-${tool}.cfg"
+		done
+	done
 }
 
 pkg_preinst() {
