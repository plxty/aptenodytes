# [aptenodytes] eclass_sync=rust-toolchain
diff --git a/dev-lang/rust-bin/rust-bin-1.95.0.ebuild b/dev-lang/rust-bin/rust-bin-1.95.0.ebuild
index 6e56692792f6..0ac2c775a8c8 100644
--- a/dev-lang/rust-bin/rust-bin-1.95.0.ebuild
+++ b/dev-lang/rust-bin/rust-bin-1.95.0.ebuild
@@ -8,6 +8,11 @@ LLVM_OPTIONAL="yes"
 
 inherit edo llvm-r1 multilib prefix rust-toolchain verify-sig multilib-minimal optfeature
 
+# filter to have only darwin to reduce download size, @see rust-toolchain.eclass
+rust_all_arch_uris() {
+	rust_arch_uri aarch64-apple-darwin "${1}" "${2}"
+}
+
 if [[ ${PV} == *9999* ]]; then
 	# We need to fetch a tarball in src_unpack
 	PROPERTIES+=" live"
@@ -24,7 +29,7 @@ else
 	SRC_URI="$(rust_all_arch_uris "rust-${PV}")
 		rust-src? ( ${RUST_TOOLCHAIN_BASEURL%/}/2026-04-16/rust-src-${PV}.tar.xz )
 	"
-	KEYWORDS="amd64 arm arm64 ~loong ~mips ppc ppc64 ~riscv ~s390 ~sparc x86"
+	KEYWORDS="~arm64-macos"
 fi
 
 GENTOO_BIN_BASEURI="https://github.com/projg2/rust-bootstrap/releases/download/${PVR}" # omit trailing slash
@@ -32,27 +37,6 @@ GENTOO_BIN_BASEURI="https://github.com/projg2/rust-bootstrap/releases/download/$
 DESCRIPTION="Systems programming language from Mozilla"
 HOMEPAGE="https://www.rust-lang.org/"
 
-if [[ ${PV} != *9999* && ${PV} != *beta* ]] ; then
-	# Keep this separate to allow easy commenting out if not yet built
-	SRC_URI+=" sparc? ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-sparc64-unknown-linux-gnu.tar.xz ) "
-	SRC_URI+=" mips? (
-		abi_mips_o32? (
-			big-endian?  ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-mips-unknown-linux-gnu.tar.xz )
-			!big-endian? ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-mipsel-unknown-linux-gnu.tar.xz )
-		)
-		abi_mips_n64? (
-			big-endian?  ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-mips64-unknown-linux-gnuabi64.tar.xz )
-			!big-endian? ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-mips64el-unknown-linux-gnuabi64.tar.xz )
-		)
-	)"
-	SRC_URI+=" riscv? (
-		elibc_musl? ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-riscv64gc-unknown-linux-musl.tar.xz )
-	)"
-	SRC_URI+=" ppc64? ( elibc_musl? (
-		big-endian?  ( ${GENTOO_BIN_BASEURI}/rust-${PVR}-powerpc64-unknown-linux-musl.tar.xz )
-	) )"
-fi
-
 LICENSE="|| ( MIT Apache-2.0 ) BSD BSD-1 BSD-2 BSD-4"
 SLOT="${PV%%_*}" # Beta releases get to share the same SLOT as the eventual stable
 IUSE="big-endian +clippy cpu_flags_x86_sse2 +doc prefix rust-analyzer rust-src +rustfmt"
@@ -62,7 +46,6 @@ RDEPEND="
 	>=app-eselect/eselect-rust-20190311
 	dev-libs/openssl
 	net-misc/curl
-	sys-apps/lsb-release
 	|| (
 		llvm-runtimes/libgcc
 		sys-devel/gcc:*
@@ -70,10 +53,7 @@ RDEPEND="
 	!dev-lang/rust:stable
 	!dev-lang/rust-bin:stable
 "
-BDEPEND="
-	prefix? ( dev-util/patchelf )
-	verify-sig? ( sec-keys/openpgp-keys-rust )
-"
+BDEPEND="verify-sig? ( sec-keys/openpgp-keys-rust )"
 [[ ${PV} == *9999* ]] && BDEPEND+=" net-misc/curl"
 
 REQUIRED_USE="x86? ( cpu_flags_x86_sse2 )"
@@ -162,6 +142,11 @@ src_unpack() {
 	esac
 }
 
+# don't patchelf on darwin:
+patchelf() {
+	:
+}
+
 patchelf_for_bin() {
 	local filetype=$(file -b ${1})
 	if [[ ${filetype} == *ELF*interpreter* ]]; then
diff --git a/eclass/rust-toolchain.eclass b/eclass/rust-toolchain.eclass
index 41fccb7c4a07..bdc86775f69f 100644
--- a/eclass/rust-toolchain.eclass
+++ b/eclass/rust-toolchain.eclass
@@ -54,6 +54,7 @@ rust_abi() {
 		sparc64*gnu)      echo sparc64-unknown-linux-gnu;;
 		x86_64*gnu)       echo x86_64-unknown-linux-gnu;;
 		x86_64*musl)      echo x86_64-unknown-linux-musl;;
+		arm64-apple-darwin*) echo aarch64-apple-darwin;;
 		*)                echo ${CTARGET};;
   esac
 }
@@ -118,5 +119,6 @@ rust_all_arch_uris()
 	riscv? ( elibc_glibc? ( $(rust_arch_uri riscv64gc-unknown-linux-gnu "${alt_basename}" "${rename_param}") ) )
 	s390?  ( elibc_glibc? ( $(rust_arch_uri s390x-unknown-linux-gnu     "${alt_basename}" "${rename_param}") ) )
 	loong? ( elibc_glibc? ( $(rust_arch_uri loongarch64-unknown-linux-gnu "${alt_basename}" "${rename_param}") ) )
+	arm64-macos? ( $(rust_arch_uri aarch64-apple-darwin "${1}" "${2}") )
 	"
 }
