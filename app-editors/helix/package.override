diff --git a/app-editors/helix/helix-25.07.1.ebuild b/app-editors/helix/helix-25.07.1.ebuild
index 4808a8abec18..e54b52c3e5e8 100644
--- a/app-editors/helix/helix-25.07.1.ebuild
+++ b/app-editors/helix/helix-25.07.1.ebuild
@@ -18,6 +18,7 @@ SRC_URI="
 	https://github.com/helix-editor/helix/releases/download/${PV}/${P}-source.tar.xz -> ${P}.tar.xz
 	https://github.com/gentoo-crate-dist/helix/releases/download/${PV}/${P}-crates.tar.xz
 "
+PATCHES=("${FILESDIR}/${PN}-fork-taste.patch")
 S="${WORKDIR}"
 
 LICENSE="MPL-2.0"
@@ -27,7 +28,7 @@ LICENSE+="
 	ZLIB
 "
 SLOT="0"
-KEYWORDS="amd64"
+KEYWORDS="amd64 ~arm64-macos"
 IUSE="+grammar"
 
 RDEPEND="dev-vcs/git"
@@ -46,6 +47,12 @@ src_install() {
 	cargo_src_install --path helix-term
 
 	insinto "/usr/$(get_libdir)/${PN}"
+	if use grammer && use kernel_Darwin; then
+		# replacing the install_name of all grammars:
+		for lib in runtime/grammars/*.so; do
+			install_name_tool -id "${EPREFIX}/usr/$(get_libdir)/${PN}/$(basename "${lib}")" "${lib}"
+		done
+	fi
 	use grammar && doins runtime/grammars/*.so
 	rm -r runtime/grammars || die
 	use grammar && dosym -r "/usr/$(get_libdir)/${PN}" "/usr/share/${PN}/runtime/grammars"
