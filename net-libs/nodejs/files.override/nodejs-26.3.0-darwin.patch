From e48a8930a0c803c8cf006fc853ca50525ab4bc48 Mon Sep 17 00:00:00 2001
From: Zigit Zo <byte@kei.network>
Date: Sat, 25 Apr 2026 03:55:37 +0800
Subject: [PATCH] node: compiles on darwin gcc

---
 common.gypi                                      | 10 ++++++++++
 deps/v8/src/inspector/string-16.h                |  4 ----
 deps/v8/src/objects/string.h                     |  2 +-
 .../time/internal/cctz/src/time_zone_format.cc   |  2 +-
 node.gyp                                         |  1 -
 tools/v8_gypfiles/features.gypi                  |  2 +-
 tools/v8_gypfiles/v8.gyp                         | 16 +---------------
 7 files changed, 14 insertions(+), 23 deletions(-)

diff --git a/common.gypi b/common.gypi
index 26c2ef3675f..47d728b72a6 100644
--- a/common.gypi
+++ b/common.gypi
@@ -755,6 +755,16 @@
               ],
             },
           }],
+          ['clang==0', {
+            'xcode_settings': {
+              'OTHER_CPLUSPLUSFLAGS': [
+                '-Wno-extra',
+                '-Wno-deprecated-declarations',
+                '-Wno-return-type',
+                '-std=gnu++20',
+              ],
+            },
+          }],
           ['clang==1', {
             'xcode_settings': {
               'GCC_VERSION': 'com.apple.compilers.llvm.clang.1_0',
diff --git a/deps/v8/src/inspector/string-16.h b/deps/v8/src/inspector/string-16.h
index fd54225179c..67fa5d34d04 100644
--- a/deps/v8/src/inspector/string-16.h
+++ b/deps/v8/src/inspector/string-16.h
@@ -163,8 +163,6 @@ String16 String16::concat(T... args) {
 
 }  // namespace v8_inspector
 
-#if !defined(__APPLE__) || defined(_LIBCPP_VERSION)
-
 namespace std {
 template <>
 struct hash<v8_inspector::String16> {
@@ -175,6 +173,4 @@ struct hash<v8_inspector::String16> {
 
 }  // namespace std
 
-#endif  // !defined(__APPLE__) || defined(_LIBCPP_VERSION)
-
 #endif  // V8_INSPECTOR_STRING_16_H_
diff --git a/deps/v8/src/objects/string.h b/deps/v8/src/objects/string.h
index c6003839758..dbf4f1fd7d9 100644
--- a/deps/v8/src/objects/string.h
+++ b/deps/v8/src/objects/string.h
@@ -21,7 +21,7 @@
 #include "src/objects/tagged.h"
 #include "src/sandbox/external-pointer.h"
 #include "src/strings/unicode-decoder.h"
-#include "third_party/simdutf/simdutf.h"
+#include "simdutf.h"
 
 // Has to be the last include (doesn't have include guards):
 #include "src/objects/object-macros.h"
diff --git a/deps/v8/third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_format.cc b/deps/v8/third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_format.cc
index 5b80c80fac5..a80865a2069 100644
--- a/deps/v8/third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_format.cc
+++ b/deps/v8/third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_format.cc
@@ -22,7 +22,7 @@
 
 #if HAS_STRPTIME
 #if !defined(_XOPEN_SOURCE) && !defined(__FreeBSD__) && !defined(__OpenBSD__)
-#define _XOPEN_SOURCE 500  // Exposes definitions for SUSv2 (UNIX 98).
+// https://github.com/abseil/abseil-cpp/issues/2027
 #endif
 #endif
 
diff --git a/node.gyp b/node.gyp
index 82c5bdaecfe..4fd7b2c9760 100644
--- a/node.gyp
+++ b/node.gyp
@@ -520,7 +520,6 @@
         '-Wendif-labels',
         '-W',
         '-Wno-unused-parameter',
-        '-Werror=undefined-inline',
         '-Werror=extra-semi',
         '-Werror=ctad-maybe-unsupported',
       ],
diff --git a/tools/v8_gypfiles/features.gypi b/tools/v8_gypfiles/features.gypi
index 0208ce11983..1c1b591a4c8 100644
--- a/tools/v8_gypfiles/features.gypi
+++ b/tools/v8_gypfiles/features.gypi
@@ -62,7 +62,7 @@
       }, {
         'is_component_build': 0,
       }],
-      ['OS == "win" or OS == "mac"', {
+      ['OS == "win"', {
         # Sets -DENABLE_SYSTEM_INSTRUMENTATION. Enables OS-dependent event tracing
         'v8_enable_system_instrumentation': 1,
       }, {
diff --git a/tools/v8_gypfiles/v8.gyp b/tools/v8_gypfiles/v8.gyp
index 945aa0aa501..a9166af1e76 100644
--- a/tools/v8_gypfiles/v8.gyp
+++ b/tools/v8_gypfiles/v8.gyp
@@ -1064,7 +1064,7 @@
         'v8_maybe_icu',
         'v8_zlib',
         'v8_pch',
-        'simdutf',
+        # simdutf should use the system one instead
         'abseil.gyp:abseil',
       ],
       'includes': ['inspector.gypi'],
@@ -2426,19 +2426,5 @@
         '<!@pymod_do_main(GN-scraper "<(HIGHWAY_ROOT)/BUILD.gn"  "source_set.\\"libhwy.*?sources = ")',
       ],
     },  # highway
-    {
-      'target_name': 'simdutf',
-      'type': 'static_library',
-      'toolsets': ['host', 'target'],
-      'direct_dependent_settings': {
-        'include_dirs': [
-          '<(V8_ROOT)/third_party/simdutf',
-        ],
-      },
-      'include_dirs': ['.'],
-      'sources': [
-        '<(V8_ROOT)/third_party/simdutf/simdutf.cpp',
-      ],
-    },  # simdutf
   ],
 }
-- 
2.55.0

